# --- Núcleo ---
# Genera una clave con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=admin/

# --- PostgreSQL ---
DB_NAME=edugest
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=0

# --- S3 Bucket Supabase ---
SUPABASE_S3_BUCKET=media
SUPABASE_S3_KEY_ID=<access-key-id>
SUPABASE_S3_SECRET=<secret>
SUPABASE_S3_URL=https://<ref-del-proyecto>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<región>

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# --- Producción (HTTPS) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
BEHIND_PROXY=False

# --- Correo (más adelante) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EduGest <no-reply@edugest.local>

# --- Logging ---
LOG_LEVEL=INFO

# --- Mantenimiento ---
# Con True la API responde 503 y el frontend muestra la pantalla de mantenimiento.
MAINTENANCE_MODE=False
MAINTENANCE_MESSAGE=Estamos realizando mejoras en EduGest. Volveremos a estar disponibles en breve.
# Texto libre opcional con la hora estimada de regreso (por ejemplo: hoy a las 18:00).
MAINTENANCE_UNTIL=
MAINTENANCE_RETRY_SECONDS=60

# --- Datos legales (política de privacidad y términos de uso) ---
# Si cambias LEGAL_VERSION, todos los usuarios deberán aceptar de nuevo al iniciar sesión.
LEGAL_VERSION=1.0
LEGAL_VIGENTE_DESDE=2026-10-21
INSTITUCION_NOMBRE=Unidad Educativa Ejemplo
INSTITUCION_CIUDAD=Guayaquil
INSTITUCION_CORREO_PRIVACIDAD=privacidad@institucion.edu.ec
# Texto libre: cuánto tiempo se conservan los datos al terminar la relación con la institución.
DATOS_PLAZO_CONSERVACION=hasta cinco años después de que el estudiante deja la institución
